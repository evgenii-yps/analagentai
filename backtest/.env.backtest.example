# Конфигурация исторического реплея (Этап 7.4). ФАЙЛ .env ПРОДАКШНА НЕ ТРОГАТЬ.
#
# Значения, помеченные «зонд», заполняются ПО РЕЗУЛЬТАТУ scripts/probe_history_depth.py.
# Подставлять их «по памяти» запрещено: конфигурация не загрузится с пустым
# значением, и это намеренно.

# Инструменты — ПАРЫ «спот:контракт», через запятую.
#
# Продакшн работает на ДВУХ рынках одновременно (замер на сервере 22.08.2026):
#   .env: SYMBOL=BTC/USDT (спот)          → инструмент OKX BTC-USDT      → свечи
#   .env: SWAP_SYMBOL=BTC/USDT:USDT       → инструмент OKX BTC-USDT-SWAP → funding
# MarketAgent получает спот, FuturesAgent — контракт (src/agents/runner.py:47-54).
#
# Свечи грузятся по СПОТУ (левая часть пары), funding — по КОНТРАКТУ (правая).
# Имя контракта из имени спота НЕ достраивается: пишите его явно. Первая пара —
# ровно та, что ведёт продакшн: на ней выполняется блокирующая сверка §13.2.
BT_INSTRUMENTS=BTC-USDT:BTC-USDT-SWAP,ETH-USDT:ETH-USDT-SWAP,SOL-USDT:SOL-USDT-SWAP

# Состав агентов прогона: market ИЛИ market,futures.
#
#   market          — funding не запрашивается ВОВСЕ (ни у биржи, ни из БД),
#                     прогоняется только конфигурация A;
#   market,futures  — дополнительно конфигурация B; тогда у КАЖДОЙ пары обязан
#                     быть указан контракт.
#
# Значение по умолчанию — market: главный вопрос этапа (Market на 55 месяцах)
# от funding не зависит, а глубина истории funding в три месяца уже признана
# разведочной. Конфигурация B включается сознательно и отдельно.
BT_AGENTS=market

BT_BAR=1H

# зонд: самая ранняя доступная точка, но НЕ позже чем 24 месяца назад.
# Если у инструмента истории меньше 24 месяцев — он исключается из BT_INSTRUMENTS.
BT_PERIOD_FROM=

# Конец периода: последние две недели исключены намеренно, чтобы результат
# нельзя было подогнать под уже известное поведение живой системы.
BT_PERIOD_TO=2026-08-01T00:00:00Z

BT_STEP_HOURS=1
BT_HORIZONS=1,4,12,24

# КРУГОВАЯ комиссия = ВХОД + ВЫХОД, в процентах от объёма сделки.
#
# Проверено 24.08.2026 (OKX, базовый уровень Lv1): тейкер спота берёт 0.10% за
# ОДНУ сделку, то есть 0.20% за круг. До Этапа 8.7 здесь стояло 0.10 — комиссия
# за одну сделку в параметре, названном круговым, то есть ПОЛОВИНА издержек.
# Числа Этапа 7.4 считались при этом заниженном значении (см. пометку в
# docs/STAGE_7_4_REPORT.md); пересчёт 7.4 не выполнялся — этап закрыт.
#
# Параметр читается ТОЛЬКО пакетом backtest/ (backtest/config.py). Порог
# покрытия издержек covers_fees (Этап 8.2) берётся из ДРУГОГО параметра —
# RISK_COST_ROUNDTRIP_PCT в .env продакшна, — поэтому правка здесь на текст
# сигнала и на решение системы не влияет.
BT_FEE_ROUNDTRIP_PCT=0.20
BT_SLIPPAGE_PCT=0.01

# Длина проверочного отрезка (out-of-sample), месяцев.
BT_OOS_MONTHS=6

# зонд: безопасная пауза между запросами с запасом x2 к первому коду 50011.
BT_REQUEST_PAUSE_MS=

# =============================================================================
# ЗАМЕР 0 (шаг 1 версии 7): история старших таймфреймов
# =============================================================================
#
# НАПОМИНАНИЕ, СТОИВШЕЕ ЭТАПА 8.7. Этот файл — ОБРАЗЕЦ. Рабочий
# backtest/.env.backtest в репозиторий НЕ ВХОДИТ и правится на сервере ВРУЧНУЮ.
# Тогда BT_FEE_ROUNDTRIP_PCT остался неисправленным именно потому, что правка
# коснулась образца, а рабочего файла — нет. Допишите ключи ниже В РАБОЧИЙ ФАЙЛ
# НА СЕРВЕРЕ; deploy/verify_z0.sh проверяет именно его.

# Масштабы старших рядов. ТОЛЬКО с суффиксом utc — и это не стилистика.
#
# У OKX дневные, недельные и месячные свечи по умолчанию открываются по
# ГОНКОНГСКОМУ времени (UTC+8), а не по UTC; для UTC существуют отдельные
# значения bar: 1Dutc, 1Wutc, 1Mutc. Часовые от этого не зависят — границы часа
# совпадают в обоих случаях. Значение без суффикса не используется НИГДЕ: ни в
# загрузке, ни в контроле. С ним контроль совпадения (§7) не сойдётся никогда,
# а причину будут искать в арифметике сборки.
BT_HTF_BARS=1Dutc,1Wutc,1Mutc

# Инструменты Замера 0 — ТОЛЬКО СПОТ, без контрактов. И теханализ, и будущий
# агент старшего таймфрейма работают по споту; контракты в этом этапе не
# участвуют вовсе, поэтому пары «спот:контракт» здесь не нужны.
BT_HTF_INSTRUMENTS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,DOGE-USDT

# ГРАНИЦА ПЕРИОДА ЧАСОВОГО РЯДА. BT_PERIOD_FROM выше должен быть
# 2022-02-01T00:00:00Z. BT_PERIOD_TO Замером 0 НЕ ЧИТАЕТСЯ ВОВСЕ: конец периода
# — последний ЗАКРЫТЫЙ час на момент запуска, и подменить его из файла нельзя.
#
# ОСОЗНАННОЕ ИЗМЕНЕНИЕ ПРОТИВ ТЗ 7.4. Там BT_PERIOD_TO стояло на 01.08.2026,
# чтобы результат нельзя было подогнать под известное поведение живой системы.
# Здесь граница снимается: Замер 1 обязан покрывать и свежие данные, а защита
# от подгонки переносится туда, где ей место, — в разделение выборки на
# обучающий и проверочный отрезки по времени. Загрузка по 01.08.2026 сделала бы
# такое разделение невозможным.

# зонд: безопасная пауза между запросами (BT_REQUEST_PAUSE_MS выше). Значение
# берётся ИЗ ВЫВОДА scripts/probe_htf_depth.py, а не из памяти: замер
# 22.08.2026 дал фактический максимум limit = 300 при ожидавшихся по
# документации 100, и ждать «по памяти» значило бы втрое больше запросов.
