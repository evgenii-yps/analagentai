# Пример переменных окружения. Скопируйте в .env и задайте значения.
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=agenttrade
POSTGRES_PASSWORD=change_me          # ОБЯЗАТЕЛЬНО: без пароля приложение не стартует
POSTGRES_DB=agenttrade
PG_HOST=postgres
PG_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Логирование ---
LOG_LEVEL=INFO

# --- Сбор данных (Этап 2) ---
EXCHANGE=binance
SYMBOL=BTC/USDT             # спотовый символ
SWAP_SYMBOL=BTC/USDT:USDT   # бессрочный фьючерс (swap)
TIMEFRAMES=1m,5m,15m,1h     # таймфреймы свечей через запятую
OHLCV_INTERVAL=30           # сек между опросами свечей
ORDERBOOK_INTERVAL=10       # сек между снимками стакана
ORDERBOOK_DEPTH=50          # глубина стакана
TRADES_INTERVAL=15          # сек между опросами сделок
FUTURES_INTERVAL=60         # сек между опросами funding/OI

# --- Аналитические агенты (Этап 3) ---
AGENT_TIMEFRAME=1h          # таймфрейм для Market Agent
AGENT_INTERVAL=60           # сек между запусками агентов
AGENT_MIN_CANDLES=200       # минимум свечей для анализа
AGENT_FAILURE_ALERT_STREAK=5   # сбоев подряд у агента → алерт в Telegram (Этап 7.0)
AGENT_AUTO_RESET_STREAK=20     # сбоев/пустых выборок подряд → самосброс агента (Этап 7.2)
FUNDING_EXTREME_THRESHOLD=0.0003  # НЕ ИСПОЛЬЗУЕТСЯ с Этапа 7.3 (оставлен для совместимости)

# --- Деривативы: перцентильные границы (Этап 7.3, Блок A) ---
# Направление Futures задаётся положением текущего funding в СВОЁМ распределении
# за окно, а не сравнением с константой: абсолютный порог и делал ветку bearish
# недостижимой (0 значений bearish за 8 суток наблюдений).
FUTURES_LOOKBACK_HOURS=168  # окно распределения, часов (неделя)
FUTURES_PCT_HIGH=0.80       # перцентиль ≥ этого → bullish
FUTURES_PCT_LOW=0.20        # перцентиль ≤ этого → bearish
FUTURES_MIN_POINTS=20       # меньше точек в окне → insufficient_data, а не neutral

# --- Decision Agent (Этап 4) ---
# Версия логики: свойство КОДА, вручную не меняется. Смена версии = новая
# граница наблюдений, статистика прежних версий с ней не смешивается.
LOGIC_VERSION=4             # v4 — Этап 7.3 (перцентильный Futures, калибровка, инерция)
DECISION_INTERVAL=60        # сек между решениями
DECISION_THRESHOLD=0.3      # порог балла для buy/sell
AGENT_FRESHNESS_SEC=300     # макс. возраст вывода агента (сек)
MIN_AGENTS=2                # минимум свежих агентов для решения
WEIGHT_MARKET=1.0           # вес Market Agent
WEIGHT_LIQUIDITY=1.0        # вес Liquidity Agent
WEIGHT_FUTURES=1.0          # вес Futures Agent

# --- Уведомления Telegram (Этап 5) ---
TELEGRAM_BOT_TOKEN=         # токен бота от @BotFather (пусто → сервис простаивает)
TELEGRAM_CHAT_ID=           # ID чата получателя
NOTIFY_INTERVAL=30          # сек между проверками новых сигналов
NOTIFY_MIN_PROBABILITY=0.7  # минимальный ИНДЕКС СОГЛАСИЯ для отправки (не менялся)
NOTIFY_MIN_AGENTS=3         # минимум содержательных агентов для ОТПРАВКИ (Этап 7.2)
NOTIFY_COOLDOWN_SEC=1800    # пауза перед повтором того же решения (сек)
NOTIFY_TIMEZONE=Europe/Moscow  # часовой пояс времени в уведомлениях

# --- Калибровка вероятности (Этап 7.3, Блок B) ---
# Индекс согласия измеряет громкость согласия агентов; вероятность успеха
# берётся из кривой, построенной по фактическим исходам. Пока кривой нет,
# вероятность = NULL и в интерфейсах не показывается вовсе.
CALIBRATION_MIN_SAMPLES=60  # минимум НЕЗАВИСИМЫХ наблюдений (≈10 суток работы)
CALIBRATION_BINS=5          # число равных корзин на диапазоне индекса [0, 1]
CALIBRATION_PRIOR_WEIGHT=10 # вес базовой ставки при сглаживании корзины
CALIBRATION_HORIZON=4h      # горизонт оценки, по которому строится кривая
NOTIFY_USE_CALIBRATED=false # true → отбор по вероятности вместо индекса согласия
NOTIFY_MIN_CALIBRATED=0.55  # порог вероятности при NOTIFY_USE_CALIBRATED=true

# --- Оценка результатов (Этап 6) ---
EVAL_INTERVAL=300           # сек между прогонами оценщика
EVAL_HORIZONS=1h,4h         # горизонты оценки через запятую
EVAL_PRIMARY_HORIZON=4h     # главный горизонт (сводка в signals, status=closed)
STATS_LOG_INTERVAL=3600     # сек между логами статистики

# --- Выгрузка сигналов (Этап 6.6) ---
EXPORT_ENABLED=true          # общий выключатель выгрузки (true/false)
EXPORT_BATCH_SIZE=500        # строк в одном запросе к Google Таблице
SHEETS_WEBAPP_URL=           # ОБЯЗАТЕЛЬНО: URL веб-приложения Apps Script (см. §8)
SHEETS_SHARED_SECRET=        # ОБЯЗАТЕЛЬНО: общий секрет Apps Script ↔ .env (см. §8)
NOTION_API_TOKEN=            # ОБЯЗАТЕЛЬНО: внутренний токен интеграции Notion (ntn_...)
NOTION_SIGNALS_DB_ID=dacf5b37-f606-40cb-b0b9-89c51762e464  # база «Журнал сигналов»
EXPORT_NOTION_ONLY_NOTIFIED=true  # в Notion только сигналы с notified_at

# --- Телеграм-бот только на чтение (Этап 6.7) ---
BOT_ENABLED=true             # выключатель сервиса бота (true/false)
BOT_POLL_TIMEOUT=30          # сек, таймаут long polling getUpdates
BOT_ALLOWED_CHAT_IDS=        # белый список chat_id через запятую (пусто → TELEGRAM_CHAT_ID)
BOT_MAX_ROWS=20              # потолок строк в /last
BOT_RATE_LIMIT_SEC=3         # мин. пауза между командами одного чата (сек)
POSTGRES_RO_PASSWORD=        # пароль роли БД только на чтение (генерируется установщиком)
