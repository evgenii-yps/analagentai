# Пример переменных окружения. Скопируйте в .env и задайте значения.
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=agenttrade
POSTGRES_PASSWORD=change_me          # ОБЯЗАТЕЛЬНО: без пароля приложение не стартует
POSTGRES_DB=agenttrade
PG_HOST=postgres
PG_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Логирование ---
LOG_LEVEL=INFO

# --- Сбор данных (Этап 2) ---
EXCHANGE=binance
SYMBOL=BTC/USDT             # спотовый символ (одна пара; см. SYMBOLS ниже)
SWAP_SYMBOL=BTC/USDT:USDT   # бессрочный фьючерс (swap) той же пары
# Этап 8.1 §1. Пары «спот:контракт» через запятую. Разделитель — ПЕРВОЕ
# двоеточие: имя контракта само содержит ':'. Достраивание имени контракта из
# имени спота ЗАПРЕЩЕНО — рынки разные (Market работает на споте, Futures на
# контракте), и догадка означала бы сбор не с того рынка.
# Пустое значение = одна пара из SYMBOL/SWAP_SYMBOL (поведение до 8.1).
# ПОЭТАПНОЕ ВКЛЮЧЕНИЕ (§2, ОБЯЗАТЕЛЬНО): сначала два токена, 2 часа работы и
# замеры scripts/measure_load.sh; только потом остальные три.
#   Шаг 1: SYMBOLS=BTC/USDT:BTC/USDT:USDT,ETH/USDT:ETH/USDT:USDT
#   Шаг 2: + SOL/USDT:SOL/USDT:USDT,XRP/USDT:XRP/USDT:USDT,DOGE/USDT:DOGE/USDT:USDT
SYMBOLS=BTC/USDT:BTC/USDT:USDT,ETH/USDT:ETH/USDT:USDT
TIMEFRAMES=1m,5m,15m,1h     # таймфреймы свечей через запятую
OHLCV_INTERVAL=30           # сек между опросами свечей
ORDERBOOK_INTERVAL=10       # сек между снимками стакана
ORDERBOOK_DEPTH=50          # глубина стакана
TRADES_INTERVAL=15          # сек между опросами сделок
FUTURES_INTERVAL=60         # сек между опросами funding/OI

# --- Аналитические агенты (Этап 3) ---
AGENT_TIMEFRAME=1h          # таймфрейм для Market Agent
AGENT_INTERVAL=60           # сек между запусками агентов
AGENT_MIN_CANDLES=200       # минимум свечей для анализа
AGENT_FAILURE_ALERT_STREAK=5   # сбоев подряд у агента → алерт в Telegram (Этап 7.0)
AGENT_AUTO_RESET_STREAK=20     # сбоев/пустых выборок подряд → самосброс агента (Этап 7.2)
FUNDING_EXTREME_THRESHOLD=0.0003  # НЕ ИСПОЛЬЗУЕТСЯ с Этапа 7.3 (оставлен для совместимости)

# --- Деривативы: перцентильные границы (Этап 7.3, Блок A) ---
# Направление Futures задаётся положением текущего funding в СВОЁМ распределении
# за окно, а не сравнением с константой: абсолютный порог и делал ветку bearish
# недостижимой (0 значений bearish за 8 суток наблюдений).
FUTURES_LOOKBACK_HOURS=168  # окно распределения, часов (неделя)
FUTURES_PCT_HIGH=0.80       # перцентиль ≥ этого → bullish
FUTURES_PCT_LOW=0.20        # перцентиль ≤ этого → bearish
FUTURES_MIN_POINTS=20       # меньше точек в окне → insufficient_data, а не neutral

# --- Decision Agent (Этап 4) ---
# Версия логики: свойство КОДА, вручную не меняется. Смена версии = новая
# граница наблюдений, статистика прежних версий с ней не смешивается.
LOGIC_VERSION=5             # v5 — Этап 8.1 (пять токенов, четыре горизонта оценки)
# Данные версий 4 и 5 НИКОГДА не смешиваются в анализе (§6 ТЗ 8.1): момент
# границы пишется в таблицу logic_version_windows при первом старте на версии.
DECISION_INTERVAL=60        # сек между решениями
DECISION_THRESHOLD=0.3      # порог балла для buy/sell
AGENT_FRESHNESS_SEC=300     # макс. возраст вывода агента (сек)
MIN_AGENTS=2                # минимум свежих агентов для решения
WEIGHT_MARKET=1.0           # вес Market Agent
WEIGHT_LIQUIDITY=1.0        # вес Liquidity Agent
WEIGHT_FUTURES=1.0          # вес Futures Agent

# --- Уведомления Telegram (Этап 5) ---
TELEGRAM_BOT_TOKEN=         # токен бота от @BotFather (пусто → сервис простаивает)
TELEGRAM_CHAT_ID=           # ID чата получателя
NOTIFY_INTERVAL=30          # сек между проверками новых сигналов
NOTIFY_MIN_PROBABILITY=0.7  # минимальный ИНДЕКС СОГЛАСИЯ для отправки (не менялся)
NOTIFY_MIN_AGENTS=3         # минимум содержательных агентов для ОТПРАВКИ (Этап 7.2)
NOTIFY_COOLDOWN_SEC=1800    # пауза перед повтором того же решения (сек)
NOTIFY_TIMEZONE=Europe/Moscow  # часовой пояс времени в уведомлениях

# --- Калибровка вероятности (Этап 7.3, Блок B) ---
# Индекс согласия измеряет громкость согласия агентов; вероятность успеха
# берётся из кривой, построенной по фактическим исходам. Пока кривой нет,
# вероятность = NULL и в интерфейсах не показывается вовсе.
CALIBRATION_MIN_SAMPLES=60  # минимум НЕЗАВИСИМЫХ наблюдений (≈10 суток работы)
CALIBRATION_BINS=5          # число равных корзин на диапазоне индекса [0, 1]
CALIBRATION_PRIOR_WEIGHT=10 # вес базовой ставки при сглаживании корзины
CALIBRATION_HORIZON=4h      # горизонт оценки, по которому строится кривая
NOTIFY_USE_CALIBRATED=false # true → отбор по вероятности вместо индекса согласия
NOTIFY_MIN_CALIBRATED=0.55  # порог вероятности при NOTIFY_USE_CALIBRATED=true

# --- Оценка результатов (Этап 6) ---
EVAL_INTERVAL=300           # сек между прогонами оценщика
# Этап 8.1 §5: четыре горизонта В ЧАСАХ, каждый считается независимо.
# Сигнал при этом остаётся ОДИН: горизонт влияет только на оценку исхода.
EVAL_HORIZONS=1,4,12,24
EVAL_PRIMARY_HORIZON=4      # главный горизонт (сводка в signals, status=closed)
# Прежний формат («1h,4h», «4h») тоже читается — значение в .env не обязано
# меняться синхронно с кодом.
STATS_LOG_INTERVAL=3600     # сек между логами статистики

# --- Срок хранения данных (Этап 8.1 §4) ---
# Ежесуточная задача: cron 03:40 UTC → scripts/retention.py.
# НИКОГДА не удаляются: часовые (и любые не 1m) свечи, funding, открытый
# интерес, сигналы и оценки.
RETENTION_1M_DAYS=30        # минутные свечи (ohlcv, timeframe='1m')
RETENTION_ORDERBOOK_DAYS=14 # снимки стакана
# Лента сделок: ДВОЕ суток СЫРЬЯ. Перед удалением ежесуточная задача сворачивает
# завершённые минуты в trade_flow_1m (число сделок, объёмы по сторонам, VWAP) —
# эти итоги не удаляются никогда. Порядок «сначала свёртка, потом удаление»
# обеспечен кодом: не свернулось — не удаляем.
# Срок выбран по бюджету диска: при 37.21 ГБ порог «свободно не меньше 40%»
# оставляет под данные 22.3 ГБ (§4.5 отчёта 8.1).
RETENTION_TRADES_DAYS=2
# Запас свёртки, минут: минута считается завершённой не сразу, потому что
# коллектор опрашивает биржу раз в 15 c и хвост минуты может быть ещё не записан.
ROLLUP_LAG_MINUTES=5
# Журнал выводов агентов: 90 суток. Перед удалением сворачивается в суточные
# итоги agent_outputs_daily (счётчики направлений, уверенность, доля повторов),
# которые не удаляются никогда. Мнения, участвовавшие в решении, остаются
# навсегда в signals.agents_payload. Без срока журнал даёт 6.6 ГБ в год на пять
# токенов. 0 — не удалять (тогда и свёртка теряет смысл).
RETENTION_AGENT_OUTPUTS_DAYS=90

# --- Незавершённый бар в окне Market Agent (Этап 8.1 §8) ---
# false (по умолчанию) — поведение системы НЕ меняется: Market видит и
#        незавершённый бар, как и до Этапа 8.1;
# true  — Market исключает незавершённый бар из окна.
# В Этапе 8.1 значение НЕ меняется: переключатель введён для измерения эффекта
# отдельным этапом.
MARKET_CLOSED_BARS_ONLY=false

# --- Цели по вероятности (Этап 8.2) ---
# Цель — ИЗМЕРЕННАЯ величина хода цены (40-й процентиль максимального
# благоприятного отклонения за 90 суток часовых свечей спота), а не уровень
# поддержки и не желаемая прибыль. В принятии решения buy/sell/wait цель НЕ
# участвует: LOGIC_VERSION Этапом 8.2 не поднимается.
#
# КРУГОВЫЕ ИЗДЕРЖКИ СПОТА на OKX (проверено 24.08.2026, базовый уровень Lv1):
#   комиссия тейкера 0.10% × 2 сделки = 0.20%; проскальзывание 0.01% × 2 = 0.02%.
# Цель считается окупающей сделку при target_pct >= 3 × этого числа (0.66%).
# Расхождение, найденное Этапом 8.2, УСТРАНЕНО Этапом 8.7: backtest/.env.backtest
# хранил BT_FEE_ROUNDTRIP_PCT=0.10 — половину круговой комиссии — и приведён к
# 0.20. Числа уже опубликованного Этапа 7.4 считались при половинных издержках и
# НЕ пересчитывались (этап закрыт); пометка стоит в docs/STAGE_7_4_REPORT.md.
# Параметры независимы: covers_fees считается ТОЛЬКО от RISK_COST_ROUNDTRIP_PCT,
# BT_FEE_ROUNDTRIP_PCT читает лишь пакет backtest/ — на решение и на текст
# сигнала он не влияет.
#
# Замер на сервере 25.08.2026: ключа RISK_COST_ROUNDTRIP_PCT в рабочем .env не
# было вовсе — действовало умолчание кода (0.22, src/core/config.py:205). То
# есть комментарий «вынесено в .env» был верен по замыслу и неверен по факту.
# Этапом 8.7 ключ добавлен в блок, который пишет установщик (deploy/install.sh),
# ровно с этим же значением: поведение не меняется, настройка становится видимой
# там, где её обещали. Здесь и в установщике значение обязано совпадать.
RISK_COST_ROUNDTRIP_PCT=0.22
RISK_WINDOW_DAYS=90          # окно выборки, суток
RISK_MIN_OBSERVATIONS=500    # минимум наблюдений на (инструмент, горизонт, направление)
RISK_TARGETS_VERSION=1       # версия МЕТОДИКИ расчёта целей (не logic_version)
RISK_BAR=1H                  # бар свечей в backtest.candles
# Пороги допуска предпроверки §1: ряд короче, устаревший, с битыми свечами или
# неликвидный целей не получает — вместо цели пишется причина data_gap.
RISK_MIN_RUN_HOURS=2160      # непрерывный ряд, часов (90 суток)
RISK_MAX_AGE_HOURS=3         # возраст последней свечи, часов
RISK_MAX_FLAT_PCT=5          # доля свечей high = low, процентов
# Догрузка свежего края свечей перед пересчётом (§7). false — считать по тому,
# что уже есть; тогда устаревший ряд забракует сама предпроверка.
RISK_BACKFILL_ENABLED=true
RISK_BACKFILL_MARGIN_DAYS=5  # запас загрузки сверх окна (§2 ТЗ: 95 суток вместо 90)

# --- Исход по границам (Этап 8.8) ---
# ВТОРАЯ, независимая оценка исхода: «какая граница задета первой» — цель,
# предел или срок. Действующая оценка (signal_evaluations) остаётся нетронутой,
# обе существуют параллельно и сравниваются позже.
# НИ ОДНО РЕШЕНИЕ СИСТЕМЫ ОТ ЭТИХ ПАРАМЕТРОВ НЕ ЗАВИСИТ: их читает только
# суточная задача (docker compose --profile tools run --rm --no-deps barrier).
#
# ПРЕДЕЛ — ПРЕДПОЛОЖЕНИЕ, А НЕ ИЗМЕРЕНИЕ. 1.0% взят владельцем до того, как
# противоположное отклонение было измерено. Таблицу для пересмотра даёт запрос
# analysis/sql/07_stop_levels.sql; менять число по итогам первой же таблицы
# ТЗ 8.8 §8 прямо запрещает — сначала доклад, потом решение.
BARRIER_STOP_PCT=1.0
# Доля неразрешимых случаев (обе границы в одном баре), выше которой метрика
# объявляется малопригодной. На расчёт не влияет — влияет только на
# предупреждение в журнале (ключ barrier_metric_unusable=1).
BARRIER_AMBIGUOUS_MAX_PCT=15
# Источники свечей. Минутный ряд даёт однозначный порядок касаний, часовой —
# нет. Оба лежат в public.ohlcv и обязаны входить в TIMEFRAMES выше, иначе
# коллектор их не собирает и расчёт всегда будет падать в no_data.
BARRIER_FINE_TIMEFRAME=1m
BARRIER_COARSE_TIMEFRAME=1h
# Издержки берутся из RISK_COST_ROUNDTRIP_PCT выше — отдельного ключа НЕТ
# намеренно: две комиссии в одной системе неминуемо разъехались бы.

# --- Базовые стратегии как линейка сравнения (Этап 8.9) ---
# Этап НИЧЕГО НЕ УЛУЧШАЕТ, он измеряет. Продажи выглядят прибыльными — но двое
# суток рынок падал, а на падающем рынке выигрывает любой сигнал на продажу,
# включая брошенную монету. Эти параметры задают линейку, по которой видно,
# отличается ли система от безмозглого правила.
# НИ ОДНО РЕШЕНИЕ СИСТЕМЫ ОТ НИХ НЕ ЗАВИСИТ: их читает только суточная задача
# (docker compose --profile tools run --rm --no-deps barrier #     python -m src.baseline_main).
#
# ЗЕРНО МОНЕТЫ. Направление coin_flip вычисляется как функция от
# (зерно, сигнал, горизонт) — одно и то же зерно всегда даёт те же направления,
# независимо от порядка обхода и числа прогонов. МЕНЯТЬ ЗЕРНО ПОСЛЕ ТОГО, КАК
# СРАВНЕНИЕ ПРОВЕДЕНО, НЕЛЬЗЯ: это тихо заменит линейку, оставив в отчёте
# числа, снятые по старой.
BASELINE_SEED=20260826
# Таймфрейм, из которого берётся цена входа для часовой сетки (§5).
BASELINE_GRID_TIMEFRAME=1m
# Предел убытка и издержки НЕ ДУБЛИРУЮТСЯ: базовые стратегии считаются теми же
# BARRIER_STOP_PCT и RISK_COST_ROUNDTRIP_PCT, что и система. Отдельные ключи
# позволили бы сравнить систему при одном пределе с монетой при другом.

# --- Выгрузка сигналов (Этап 6.6) ---
EXPORT_ENABLED=true          # общий выключатель выгрузки (true/false)
EXPORT_BATCH_SIZE=500        # строк в одном запросе к Google Таблице
SHEETS_WEBAPP_URL=           # ОБЯЗАТЕЛЬНО: URL веб-приложения Apps Script (см. §8)
SHEETS_SHARED_SECRET=        # ОБЯЗАТЕЛЬНО: общий секрет Apps Script ↔ .env (см. §8)
NOTION_API_TOKEN=            # ОБЯЗАТЕЛЬНО: внутренний токен интеграции Notion (ntn_...)
NOTION_SIGNALS_DB_ID=dacf5b37-f606-40cb-b0b9-89c51762e464  # база «Журнал сигналов»
EXPORT_NOTION_ONLY_NOTIFIED=true  # в Notion только сигналы с notified_at
# --- Версия логики в выгрузке (Этап 8.2 §9) ---
# Замер 24.08.2026: лист «Независимые окна» содержал версии 1, 2 и 3 вперемешку —
# в отборе не было условия по logic_version. Сравнивать исходы разных версий
# нельзя: у них разный состав агентов, пороги и набор горизонтов.
#   current — последняя открытая версия из logic_version_windows (ПО УМОЛЧАНИЮ);
#   число   — именно эта версия (например, 5);
#   all     — все версии; тогда лист НАЧИНАЕТСЯ прямой оговоркой о смешивании.
# Версия 0 («неизвестна») не попадает в выборку НИ ПРИ КАКОМ значении.
EXPORT_LOGIC_VERSION=current

# --- Телеграм-бот только на чтение (Этап 6.7) ---
BOT_ENABLED=true             # выключатель сервиса бота (true/false)
BOT_POLL_TIMEOUT=30          # сек, таймаут long polling getUpdates
BOT_ALLOWED_CHAT_IDS=        # белый список chat_id через запятую (пусто → TELEGRAM_CHAT_ID)
BOT_MAX_ROWS=20              # потолок строк в /last
BOT_RATE_LIMIT_SEC=3         # мин. пауза между командами одного чата (сек)
POSTGRES_RO_PASSWORD=        # пароль роли БД только на чтение (генерируется установщиком)
