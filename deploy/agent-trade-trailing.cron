# Расчёт исходов подвижного выхода Agent Trade (Этап 8.10 §7) — ШАБЛОН для
# ручной доустановки на УЖЕ работающем сервере:
#   sudo cp deploy/agent-trade-trailing.cron /etc/cron.d/agent-trade-trailing
#   sudo chmod 644 /etc/cron.d/agent-trade-trailing
# На новом сервере эту строку ставит сам install.sh.
#
# Нового сервиса этап не заводит: используется тот же контейнер профиля tools,
# что и расчёты 8.8 и 8.9, только с другой командой (§7 ТЗ).
#
# 04:40 UTC — время задано §7 ТЗ, и порядок здесь СОДЕРЖАТЕЛЬНЫЙ:
#   03:40 — цели (risk) и политика хранения;
#   04:10 — исходы системы по границам (barrier);
#   04:25 — базовые стратегии (baseline);
#   04:40 — ЭТОТ расчёт;
#   06:20 — выгрузка (export).
# Подвижный выход берёт пары входа ИЗ таблицы исходов системы, поэтому запуск
# раньше 04:10 считал бы варианты по вчерашнему набору сигналов — то есть
# сравнивал бы выходы на разных выборках.
# Запуск ПОСЛЕ политики хранения обязателен по той же причине, что и у 8.8:
# политика удаляет минутные свечи старше RETENTION_1M_DAYS, и расчёт до неё дал
# бы разрешение '1m' по свечам, которых через час уже не будет.
#
# ЧТО СЧИТАЕТСЯ СБОЕМ. Код 1 — реальный сбой (база недоступна, ошибка записи)
# ЛИБО расхождение контрольного варианта с signal_outcomes_barrier: в этом
# случае сравнение вариантов недействительно целиком, и молчать об этом нельзя.
# Исходы no_data и ambiguous сбоем НЕ считаются.
#
# Признак успеха и ЗАМЕР ВРЕМЕНИ (§7 ТЗ) ищите по машиночитаемым ключам
# (журнал хранит кириллицу экранированной, поэтому искать по русским словам
# бесполезно):
#   grep -o 'trailing_compute_done=1.*seconds=[0-9.]*' /opt/agent-trade/logs/trailing.log
# БЛОКИРУЮЩЕЕ расхождение контрольного варианта:
#   grep 'trailing_control_mismatch=1' /opt/agent-trade/logs/trailing.log
# Если seconds устойчиво превышает 900 (15 минут — потолок §7 ТЗ) — доложить
# исполнителю: значит, чтение окон надо переписывать пакетами.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

40 4 * * * agent cd /opt/agent-trade && /usr/bin/docker compose --profile tools run --rm --no-deps barrier python -m src.trailing_main >> /opt/agent-trade/logs/trailing.log 2>&1
